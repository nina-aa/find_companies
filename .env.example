# Copy to .env and fill in. .env is git-ignored.

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai            # openai | fake

# --- HTTP API ---
AGENT_API_KEY=change-me        # X-API-Key shared secret for POST /agent/search (optional; unset = open)
AGENT_DEADLINE_S=90            # per-run wall-clock deadline enforced by BudgetGuard
